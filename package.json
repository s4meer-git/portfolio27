{
  "name": "s4meer-portfolio",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "cms:setup": "node scripts/setup-cms.mjs",
    "cms:dev": "npm exec --yes --package=node@22 -c \"npm run develop --prefix cms\"",
    "cms:build": "npm exec --yes --package=node@22 -c \"npm run build --prefix cms\"",
    "cms:start": "npm exec --yes --package=node@22 -c \"npm run start --prefix cms\"",
    "cms:install": "npm exec --yes --package=node@22 -c \"npm ci --prefix cms\"",
    "start": "node dist/server/entry.mjs",
    "test:cms": "node tests/cms-integration.mjs && node tests/cms-icons.mjs && node tests/sections.mjs && node tests/admin-fields.mjs && node tests/contributions.mjs",
    "cms:sync-icons": "node scripts/sync-custom-icons.mjs",
    "test:icons": "node tests/cms-icons.mjs",
    "test:game": "node tests/dino-game.mjs",
    "test:sections": "node tests/sections.mjs",
    "spotify:connect": "node scripts/connect-spotify.mjs",
    "test:admin": "node tests/admin-fields.mjs",
    "test:spotify-preview": "node tests/spotify-preview.mjs",
    "test:contributions": "node tests/contributions.mjs",
    "test:command-menu": "node tests/command-menu.mjs",
    "test:contact": "node tests/contact-form.mjs",
    "test:certifications": "node tests/certification-tickets.mjs",
    "test:seo": "node tests/seo.mjs && node tests/seo-revalidation.mjs && node tests/seo-cache.mjs && node tests/seo-http.mjs",
    "test:seo-cms": "node tests/seo-cms-updates.mjs",
    "test:organization-logos": "node tests/organization-logos.mjs",
    "test:organization-logos:browser": "node tests/organization-logo-browser.mjs",
    "test:portraits": "node tests/portrait-cms.mjs && node tests/portrait-switch.mjs && node tests/portrait-resilience.mjs",
    "cms:backup": "python3 scripts/cms-backup.py create",
    "cms:verify-backup": "python3 scripts/cms-backup.py verify",
    "cms:restore": "python3 scripts/cms-backup.py restore"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.1",
    "@astrojs/node": "^9.1.3",
    "@astrojs/react": "^4.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.16",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/parser": "^8.28.0",
    "@vercel/analytics": "^1.5.0",
    "astro": "^5.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "developer-icons": "^5.3.2",
    "eslint": "^9.23.0",
    "eslint-plugin-astro": "^1.3.1",
    "framer-motion": "^12.6.0",
    "gray-matter": "^4.0.3",
    "install": "^0.13.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.484.0",
    "markdown-it": "^14.1.0",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "qrcode": "^1.5.4",
    "qss": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "reading-time": "^1.5.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.16",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
