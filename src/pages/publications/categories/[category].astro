---
import PublicationsPage from "@/components/publications-page.astro";
const { category: slug } = Astro.params;
const portfolio = Astro.locals.portfolio;
const category = portfolio.categories.find(item => item.slug === slug);
const hasPublications = portfolio.publications.some(item => item.data.category?.slug === slug);
if (!category || !hasPublications) return new Response("Category not found", { status: 404 });
---

<PublicationsPage filter={category} />
