---
/**
 * Opens the command menu. Plain HTML, so it renders before the menu's island
 * hydrates; a click that early is remembered and the menu opens once it is ready.
 */
---

<button
  type="button"
  class="command-trigger"
  data-command-menu-trigger
  aria-label="Search (⌘K)"
  aria-keyshortcuts="Meta+K Control+K"
>
  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="size-4">
    <circle cx="10.5" cy="10.5" r="7.5" stroke="currentColor" stroke-width="2"
    ></circle>
    <path d="M21 21L16 16" stroke="currentColor" stroke-width="2" stroke-linecap="round"
    ></path>
  </svg>
  <span class="command-keys" data-os="mac">
    <kbd>⌘</kbd><kbd>K</kbd>
  </span>
  <span class="command-keys" data-os="other">
    <kbd class="wide">Ctrl</kbd><kbd>K</kbd>
  </span>
</button>

<script>
  // Show ⌘ on Apple platforms and Ctrl elsewhere.
  const mac = /Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent);
  const markPlatform = () =>
    document.documentElement.classList.toggle("os-mac", mac);
  markPlatform();
  // Navigation replaces the <html> attributes with the new page's.
  document.addEventListener("astro:after-swap", markPlatform);

  // Clicked before the menu is interactive: let it open on hydration.
  document.addEventListener("click", event => {
    if (
      event.target instanceof Element &&
      event.target.closest("[data-command-menu-trigger]") &&
      !document.querySelector("astro-island[component-export='CommandMenu']:not([ssr])")
    )
      document.documentElement.dataset.commandMenuPending = "true";
  });
</script>

<style>
  .command-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: 2rem;
    padding: 0 0.375rem;
    border-radius: 0.5rem;
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }
  .command-trigger:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--accent));
  }
  .command-trigger:focus-visible {
    outline: 2px solid hsl(var(--ring));
    outline-offset: 2px;
  }
  .command-keys {
    display: none;
    gap: 0.1875rem;
  }
  kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 0.25rem;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    line-height: 1;
    background: rgb(0 0 0 / 0.05);
    box-shadow: inset 0 0 1px rgb(0 0 0 / 0.1);
  }
  kbd.wide {
    width: auto;
    padding: 0 0.25rem;
  }
  :global(.dark) kbd {
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 1px rgb(255 255 255 / 0.2);
  }
  @media (min-width: 640px) {
    :global(html.os-mac) .command-keys[data-os="mac"],
    :global(html:not(.os-mac)) .command-keys[data-os="other"] {
      display: inline-flex;
    }
  }
</style>
