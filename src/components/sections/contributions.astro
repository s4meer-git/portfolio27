---
/**
 * The activity heatmap, with tabs for GitHub, LeetCode and the two combined.
 *
 * Layout follows ncdai/chanhdai.com (MIT): 12px squares on a 2px gap, month labels
 * above, and a figure caption with a legend beneath. Every tab's data is rendered
 * into the page, so switching is instant and needs no further requests.
 */
import Box from "@/components/box/index.astro";
import {
  loadContributions,
  toWeeks,
  monthLabels,
  formatRange,
  type ContributionDay,
} from "@/lib/contributions";

const settings = Astro.locals.portfolio.site.contributions;
const data = settings?.enabled ? await loadContributions() : { enabled: false };
const sources = data.enabled ? (data.sources ?? {}) : {};

const tabs = (
  [
    ["overall", settings?.overallLabel || "Overall"],
    ["github", settings?.githubLabel || "GitHub"],
    ["leetcode", settings?.leetcodeLabel || "LeetCode"],
  ] as const
).filter(([key]) => sources[key]);

const preferred = settings?.defaultView || "overall";
const active = tabs.find(([key]) => key === preferred)?.[0] ?? tabs[0]?.[0];
const current = active ? sources[active] : undefined;

const SIZE = 12;
const GAP = 2;
const RADIUS = 2;
const STEP = SIZE + GAP;

const weeks = current ? toWeeks(current.days) : [];
const months = monthLabels(weeks);
const width = weeks.length * STEP - GAP;

const sourceLinks: Record<string, { label: string; href: string }> = {
  github: {
    label: "GitHub",
    href: `https://github.com/${settings?.githubUsername ?? ""}`,
  },
  leetcode: {
    label: "LeetCode",
    href: `https://leetcode.com/u/${settings?.leetcodeUsername ?? ""}`,
  },
};
---

{
  current && active && (
    <Box id="contributions">
      <h2 class="sr-only">Contributions</h2>

      <figure class="contributions space-y-4 py-4" data-active={active}>
        {tabs.length > 1 && (
          <div
            class="flex items-center gap-1 px-4"
            role="tablist"
            aria-label="Contribution source"
          >
            {tabs.map(([key, label]) => (
              <button
                type="button"
                class="contrib-tab"
                role="tab"
                data-view={key}
                aria-selected={String(key === active)}
              >
                {label}
              </button>
            ))}
          </div>
        )}

        <contribution-scroll
          class="contrib-scroll px-4"
          tabindex="0"
          role="region"
          aria-label="Scrollable contribution calendar"
        >
          <div class="contrib-calendar" style={`--calendar-width: ${width}px`}>
          <div class="contrib-months" aria-hidden="true">
            {months.map(month => (
              <span style={`left: ${(month.index * STEP / width) * 100}%`}>
                {month.name}
              </span>
            ))}
          </div>
          <svg
            class="contrib-grid"
            width={width}
            height={7 * STEP - GAP}
            viewBox={`0 0 ${width} ${7 * STEP - GAP}`}
            role="img"
            aria-label="Contribution activity over the last year"
          >
            {weeks.map((week, weekIndex) =>
              week.map((day: ContributionDay | null, dayIndex: number) =>
                day ? (
                  <rect
                    class="contrib-cell"
                    data-date={day.date}
                    data-level={day.level}
                    x={weekIndex * STEP}
                    y={dayIndex * STEP}
                    width={SIZE}
                    height={SIZE}
                    rx={RADIUS}
                  >
                    <title>
                      {day.count} on {day.date}
                    </title>
                  </rect>
                ) : null
              )
            )}
          </svg>
          </div>
        </contribution-scroll>

        <div class="flex flex-wrap items-center justify-between gap-3 px-4 text-sm">
          <figcaption class="text-pretty tabular-nums">
            <span data-contrib-total>{current.total.toLocaleString("en")}</span>
            {" contributions, "}
            <span data-contrib-range>{formatRange(current.days)}</span>
            {". Source: "}
            <span
              data-contrib-source
              set:html={
                (active === "overall"
                  ? `<a class="underline underline-offset-4" href="${sourceLinks.github.href}" target="_blank" rel="noopener noreferrer">GitHub</a> and <a class="underline underline-offset-4" href="${sourceLinks.leetcode.href}" target="_blank" rel="noopener noreferrer">LeetCode</a>`
                  : `<a class="underline underline-offset-4" href="${sourceLinks[active].href}" target="_blank" rel="noopener noreferrer">${sourceLinks[active].label}</a>`) +
                "."
              }
            />
          </figcaption>

          <div
            class="flex items-center gap-[2px] text-muted-foreground"
            aria-hidden="true"
          >
            <span class="mr-1">Less</span>
            {[0, 1, 2, 3, 4].map(level => (
              <span class="contrib-cell contrib-key" data-level={level} />
            ))}
            <span class="ml-1">More</span>
          </div>
        </div>
      </figure>

      <script
        type="application/json"
        data-contributions
        set:html={JSON.stringify({
          sources,
          links: sourceLinks,
        })}
      />
    </Box>
  )
}

<style>
  .contrib-scroll {
    display: block;
    min-width: 0;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    /* Chanh Dai's scroll-fade-x: 12%/40px edges, 96px eased reveal. */
    mask-image: linear-gradient(to right, transparent, #000 var(--contrib-fade-start, 0px), #000 calc(100% - var(--contrib-fade-end, 0px)), transparent);
    mask-repeat: no-repeat;
  }
  .contrib-scroll::-webkit-scrollbar {
    display: none;
  }
  .contrib-scroll:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: -2px;
  }
  .contrib-scroll[data-overflow="false"] {
    mask-image: none;
  }
  .contrib-calendar {
    width: 100%;
    min-width: var(--calendar-width);
  }
  .contrib-grid {
    display: block;
    width: 100%;
    height: auto;
  }
  .contrib-months {
    position: relative;
    height: 1.75rem;
    overflow: hidden;
    color: var(--color-muted-foreground);
    font-size: 0.875rem;
    line-height: 1.25rem;
  }
  .contrib-months span {
    position: absolute;
    top: 0;
  }
  @property --contrib-fade-start {
    syntax: "<length-percentage>";
    inherits: false;
    initial-value: 0px;
  }
  @property --contrib-fade-end {
    syntax: "<length-percentage>";
    inherits: false;
    initial-value: 0px;
  }
  @keyframes contrib-fade-start {
    from { --contrib-fade-start: 0px; }
    to { --contrib-fade-start: min(12%, 40px); }
  }
  @keyframes contrib-fade-end {
    from { --contrib-fade-end: min(12%, 40px); }
    to { --contrib-fade-end: 0px; }
  }
  @supports (animation-timeline: scroll(self inline)) {
    .contrib-scroll {
      animation: contrib-fade-start 1ms ease-in-out both, contrib-fade-end 1ms ease-in-out both;
      animation-timeline: scroll(self inline), scroll(self inline);
      animation-range: 0px 96px, calc(100% - 96px) 100%;
    }
  }
  /* One ink, five weights, so the grid reads the same in either theme. */
  .contrib-cell[data-level="0"] {
    fill: color-mix(in oklab, currentColor 8%, transparent);
    background: color-mix(in oklab, currentColor 8%, transparent);
  }
  .contrib-cell[data-level="1"] {
    fill: color-mix(in oklab, currentColor 26%, transparent);
    background: color-mix(in oklab, currentColor 26%, transparent);
  }
  .contrib-cell[data-level="2"] {
    fill: color-mix(in oklab, currentColor 45%, transparent);
    background: color-mix(in oklab, currentColor 45%, transparent);
  }
  .contrib-cell[data-level="3"] {
    fill: color-mix(in oklab, currentColor 65%, transparent);
    background: color-mix(in oklab, currentColor 65%, transparent);
  }
  .contrib-cell[data-level="4"] {
    fill: color-mix(in oklab, currentColor 85%, transparent);
    background: color-mix(in oklab, currentColor 85%, transparent);
  }
  .contrib-key {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 2px;
  }

  .contrib-tab {
    cursor: pointer;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-muted-foreground);
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
  }
  .contrib-tab:hover {
    color: var(--color-foreground);
    border-color: var(--color-foreground);
  }
  .contrib-tab[aria-selected="true"] {
    color: var(--color-background);
    background: var(--color-foreground);
    border-color: var(--color-foreground);
  }
  .contrib-tab:focus-visible {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .contrib-tab {
      transition: none;
    }
  }
</style>

<script>
  class ContributionScroll extends HTMLElement {
    observer?: ResizeObserver;
    pinnedToEnd = true;

    updateFade = () => {
      const end = Math.max(0, this.scrollWidth - this.clientWidth);
      const position = Math.max(0, Math.min(this.scrollLeft, end));
      this.pinnedToEnd = end - position <= 1;
      this.dataset.overflow = String(end > 1);
      // Fallback for browsers without CSS scroll-driven animations.
      if (!CSS.supports("animation-timeline", "scroll(self inline)")) {
        const size = Math.min(this.clientWidth * 0.12, 40);
        this.style.setProperty("--contrib-fade-start", `${size * Math.min(position / 96, 1)}px`);
        this.style.setProperty("--contrib-fade-end", `${size * Math.min((end - position) / 96, 1)}px`);
      }
    };

    connectedCallback() {
      this.scrollLeft = this.scrollWidth;
      this.updateFade();
      this.addEventListener("scroll", this.updateFade, { passive: true });
      this.observer = new ResizeObserver(() => {
        if (this.pinnedToEnd) this.scrollLeft = this.scrollWidth;
        this.updateFade();
      });
      this.observer.observe(this);
      const calendar = this.querySelector(".contrib-calendar");
      if (calendar) this.observer.observe(calendar);
    }

    disconnectedCallback() {
      this.observer?.disconnect();
      this.removeEventListener("scroll", this.updateFade);
    }
  }
  if (!customElements.get("contribution-scroll")) {
    customElements.define("contribution-scroll", ContributionScroll);
  }

  function setupContributions() {
    const figure = document.querySelector<HTMLElement>(".contributions");
    const payload = document.querySelector<HTMLScriptElement>(
      "[data-contributions]"
    );
    if (!figure || !payload || figure.dataset.ready) return;
    figure.dataset.ready = "true";

    const { sources, links } = JSON.parse(payload.textContent || "{}");
    const cells = [
      ...figure.querySelectorAll<SVGRectElement>(".contrib-grid .contrib-cell"),
    ];
    const total = figure.querySelector<HTMLElement>("[data-contrib-total]");
    const range = figure.querySelector<HTMLElement>("[data-contrib-range]");
    const source = figure.querySelector<HTMLElement>("[data-contrib-source]");

    const stamp = (value: string) => {
      const [year, month, day] = value.split("-");
      return `${day}.${month}.${year}`;
    };
    const link = (key: "github" | "leetcode") =>
      `<a class="underline underline-offset-4" href="${links[key].href}" target="_blank" rel="noopener noreferrer">${links[key].label}</a>`;

    /*
      Every source's shading is worked out once, up front, as one level and one
      tooltip per cell. Switching tabs then only writes the cells whose level
      actually changes, all in a single frame and without per-cell fades, so the
      whole grid swaps at once instead of squares catching up one by one. A day a
      source does not have shows as empty rather than keeping the previous shade.
    */
    const titles = cells.map(cell => cell.querySelector("title"));
    const prepared: Record<string, { levels: string[]; labels: string[] }> = {};
    for (const [view, data] of Object.entries<any>(sources)) {
      const byDate = new Map(data.days.map((day: any) => [day.date, day]));
      const levels: string[] = [];
      const labels: string[] = [];
      for (const cell of cells) {
        const date = cell.dataset.date || "";
        const day: any = byDate.get(date);
        levels.push(String(day?.level ?? 0));
        labels.push(`${day?.count ?? 0} on ${date}`);
      }
      prepared[view] = { levels, labels };
    }

    let frame = 0;
    function show(view: string) {
      const data = sources[view];
      const next = prepared[view];
      if (!data || !next) return;

      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        for (let i = 0; i < cells.length; i++) {
          if (cells[i].dataset.level !== next.levels[i]) cells[i].dataset.level = next.levels[i];
          const title = titles[i];
          if (title && title.textContent !== next.labels[i]) title.textContent = next.labels[i];
        }
      });

      if (total) total.textContent = Number(data.total).toLocaleString("en");
      if (range) {
        range.textContent = `${stamp(data.days[0].date)} – ${stamp(data.days[data.days.length - 1].date)}`;
      }
      if (source) {
        source.innerHTML =
          (view === "overall"
            ? `${link("github")} and ${link("leetcode")}`
            : link(view as any)) + ".";
      }

      figure.dataset.active = view;
      for (const tab of figure.querySelectorAll<HTMLButtonElement>(
        ".contrib-tab"
      )) {
        tab.setAttribute("aria-selected", String(tab.dataset.view === view));
      }
    }

    for (const tab of figure.querySelectorAll<HTMLButtonElement>(
      ".contrib-tab"
    )) {
      tab.addEventListener("click", () => show(tab.dataset.view || "overall"));
    }
  }

  setupContributions();
  document.addEventListener("astro:page-load", setupContributions);
</script>
