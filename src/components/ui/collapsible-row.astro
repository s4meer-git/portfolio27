---
/**
 * A trigger plus a panel that animates open and closed.
 *
 * The open state lives in `data-open` on the wrapper, which is also what the
 * chevron animation keys off. The panel animates via `grid-template-rows: 0fr -> 1fr`
 * rather than a height, so the content measures itself and no JavaScript is needed
 * to compute a pixel height.
 *
 * A row with nothing to reveal renders as a plain div, so it is neither focusable
 * nor announced as a button.
 */
interface Props {
  /** When false the row cannot open and no chevron is shown. */
  expandable?: boolean;
  defaultOpen?: boolean;
  label?: string;
  className?: string;
}

const {
  expandable = true,
  defaultOpen = false,
  label,
  className,
} = Astro.props;
const open = expandable && defaultOpen;
---

<div
  class:list={["collapsible-row group/row relative", className]}
  data-open={String(open)}
  data-expandable={String(expandable)}
>
  {
    expandable ? (
      <button
        type="button"
        class="row-trigger group block w-full cursor-pointer text-left"
        aria-expanded={String(open)}
        aria-label={label}
      >
        <slot name="trigger" />
      </button>
    ) : (
      <div class="row-trigger block w-full text-left">
        <slot name="trigger" />
      </div>
    )
  }

  <div class="row-panel">
    <div class="row-panel-inner">
      <slot name="panel" />
    </div>
  </div>

  <slot name="after" />
</div>

<style>
  /* The hover wash sits behind the row, inset from the timeline rail on the left. */
  .row-trigger {
    position: relative;
    outline: none;
  }
  .row-trigger::before {
    content: "";
    position: absolute;
    inset: -0.25rem -0.25rem -0.375rem 1.75rem;
    z-index: -1;
    border-radius: 0.5rem;
    transition: background-color 150ms ease-out;
  }
  button.row-trigger:hover::before {
    background-color: var(--color-muted);
  }
  button.row-trigger:focus-visible::before {
    box-shadow: inset 0 0 0 2px
      color-mix(in srgb, var(--color-ring) 50%, transparent);
  }

  .row-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 200ms cubic-bezier(0.42, 0, 0.58, 1);
  }
  .collapsible-row[data-open="true"] .row-panel {
    grid-template-rows: 1fr;
  }
  .row-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .row-panel {
      transition: none;
    }
  }
</style>

<script>
  // One delegated listener covers every row on the page, including rows added by a
  // view transition.
  function bindCollapsibles() {
    document.addEventListener("click", event => {
      const trigger = (event.target as HTMLElement)?.closest?.(
        "button.row-trigger"
      );
      if (!trigger) return;
      const row = trigger.closest(".collapsible-row") as HTMLElement | null;
      if (!row) return;
      const open = row.dataset.open !== "true";
      row.dataset.open = String(open);
      trigger.setAttribute("aria-expanded", String(open));
    });
  }

  if (!(window as any).__collapsibleRowsBound) {
    (window as any).__collapsibleRowsBound = true;
    bindCollapsibles();
  }
</script>
