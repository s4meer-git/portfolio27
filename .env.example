CMS_URL=http://127.0.0.1:1337
# Optional server-only origin for website → CMS calls inside Docker.
# CMS_INTERNAL_URL=http://cms:1337

# Optional deployed commit SHA for the footer (runtime server environment).
# VERCEL_GIT_COMMIT_SHA, CF_PAGES_COMMIT_SHA, COMMIT_REF, or GITHUB_SHA also work.
# BUILD_COMMIT_SHA=
# Optional server-only token for private repositories / higher GitHub API limits.
# GITHUB_TOKEN=

# Shared secret the CMS sends to /api/revalidate after edits (match cms/.env).
# REVALIDATE_SECRET=

# Astro's build-time origin. Live canonical URLs are controlled by
# Website settings → Search & sharing → Primary domain in the CMS.
# SITE_URL=https://s4meer.com

# Set on staging/preview servers to send an HTTP noindex header regardless of CMS.
# Unknown request hosts also receive noindex automatically. Configure reverse
# proxies to preserve the original public Host header.
# SEO_INDEXING_DISABLED=true

# Persistent directory for optimized portraits, logos and link previews.
# IMAGE_CACHE_DIR=/var/lib/portfolio/image-cache
