HOST=127.0.0.1
PORT=1337
APP_KEYS=replace-with-random-key-one,replace-with-random-key-two
ADMIN_JWT_SECRET=replace-with-random-secret
API_TOKEN_SALT=replace-with-random-secret
TRANSFER_TOKEN_SALT=replace-with-random-secret
ENCRYPTION_KEY=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
DATABASE_FILENAME=.tmp/data.db
# Public CMS origin and reverse-proxy support for Coolify.
# PUBLIC_URL=https://cms.s4meer.com
# TRUST_PROXY=true
# Optional internal website origin for CMS publish notifications.
# SITE_INTERNAL_URL=http://website:4321
# Directory mount for Spotify credentials and state (supports atomic saves).
# SPOTIFY_STORAGE_DIR=.tmp
# Optional production Spotify callback; use your CMS's public HTTPS origin.
# SPOTIFY_REDIRECT_URI=https://cms.example.com/spotify-connection/callback
# Public origin of the Astro site, pinged to refresh its content cache after edits.
# SITE_URL=https://s4meer.com
# Shared with the site's REVALIDATE_SECRET; leave both unset for local development.
# REVALIDATE_SECRET=
# Contact-form email notifications over SMTP (any provider: Gmail with an app
# password, Resend, Brevo, Postmark, Fastmail…). Leave SMTP_HOST unset to only store
# messages in the CMS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Portfolio <you@gmail.com>
# Where notifications go; defaults to the email address on your profile.
# CONTACT_NOTIFY_TO=you@example.com

# Resend API notifications; use a verified sender on your sending domain.
# RESEND_API_KEY=
# SMTP_FROM=Portfolio <contact@mail.s4meer.com>

# Optional owner administrator credentials (server-only; applied on CMS startup).
# CMS_LOGIN_ID=owner@example.com
# CMS_PASS=
